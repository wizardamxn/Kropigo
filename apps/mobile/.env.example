# Copy to .env and fill in. .env is gitignored — never commit real keys.
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api/v1
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_API_KEY=

# Google Cloud → "Maps SDK for Android" → API key, restricted to the
# com.kropigo.app package + your signing SHA-1. Map loads are not billed, but
# without a key the map renders as a blank grey grid.
GOOGLE_MAPS_API_KEY=
